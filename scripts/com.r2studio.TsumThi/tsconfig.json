{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "DOM"],
    "outDir": "./build",
    "rootDir": "./src",
    "removeComments": false,
    "newLine": "lf",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
